# Copy to .env and fill in real values. .env is gitignored — never commit real keys.

# Extraction (LLM fact extraction). Optional: leave EXTRACTION_API_KEY empty to skip
# extraction — add_memory then falls back to storing a single un-extracted memory.
EXTRACTION_PROVIDER=OpenAI
EXTRACTION_API_KEY=
EXTRACTION_MODEL=gpt-4o-mini

# Embeddings. The schema stores halfvec(3072), so the model MUST produce 3072-dim
# vectors natively (gemini-embedding-001 does; text-embedding-3-small does not).
EMBEDDINGS_PROVIDER=Gemini
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=gemini-embedding-001
